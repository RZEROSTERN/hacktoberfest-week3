{
  "name": "scopewise-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Scopewise: turns a recorded client call into a draft proposal, entirely on this computer.",
  "author": "Marco Ramírez",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
