# Development configuration. `make setup` copies this to .env (git-ignored).
# The packaged desktop app sets these itself; never rely on these values in code.

# Port the api listens on (it always binds to 127.0.0.1).
SCOPEWISE_PORT=8765

# Natively running Ollama on this Mac (not Docker, so it can use the Apple Silicon GPU).
SCOPEWISE_OLLAMA_URL=http://127.0.0.1:11434

# Origins allowed to call the api (the Nuxt dev server). JSON list.
SCOPEWISE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional: override where data and models live (defaults to ./.dev/ in the repo).
# SCOPEWISE_DATA_DIR=/absolute/path/to/data
# SCOPEWISE_MODELS_DIR=/absolute/path/to/models

# Optional: point the web dev server at a different api URL (defaults to the port above).
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8765
