# Development configuration. `make setup` copies this to .env (git-ignored).
# The packaged desktop app sets these itself; never rely on these values in code.

# Port the api listens on (it always binds to 127.0.0.1).
POSTCALL_PORT=8765

# Natively running Ollama on this Mac (not Docker, so it can use the Apple Silicon GPU).
POSTCALL_OLLAMA_URL=http://127.0.0.1:11434

# Origins allowed to call the api (the Nuxt dev server). JSON list.
POSTCALL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Transcription engine from `make whisper-dev` (defaults to ./.dev/ in the repo). The test model is a
# small one (base) so tests stay light; the dev model is the one the app ships with.
# POSTCALL_WHISPER_CLI=/absolute/path/to/whisper-cli
# Audio converter: unset uses macOS afconvert, or ffmpeg elsewhere. The Linux packages set this themselves.
# POSTCALL_FFMPEG=/absolute/path/to/ffmpeg
# Optional override that skips the speech-model download (development and tests only). Normally the
# app downloads it itself in the setup screen, into the models folder.
# POSTCALL_WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
# POSTCALL_TEST_WHISPER_MODEL=/absolute/path/to/ggml-base-q5_1.bin
# POSTCALL_WHISPER_THREADS=4

# Language model seed for development (the packaged app chooses it in the setup wizard and stores it
# in the local settings; the code never hard-codes a tag).
# POSTCALL_LLM_MODEL=gemma4:e4b

# Optional: override where data and models live (defaults to ./.dev/ in the repo).
# POSTCALL_DATA_DIR=/absolute/path/to/data
# POSTCALL_MODELS_DIR=/absolute/path/to/models

# Optional: point the web dev server at a different api URL (defaults to the port above).
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8765
